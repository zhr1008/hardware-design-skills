      ],
      "affects": [
        "verification-coverage",
        "firmware-interface"
      ]
    },
    "filter-stability": {
      "severity": "engineering",
      "reason": "核源/负载、有效容值、Q、环路和实际阻带。Sallen-Key 等规则按实际拓扑筛选。",
      "rules": [
        "filter-source-loading",
        "filter-q-gain",
        "filter-high-frequency-stopband"
      ],
      "references": [
        "../design-and-review-circuit/references/power-and-analog-review.md",
        "references/engineering-budgets.md"
      ],
      "stages": [
        "saved_artifact",
        "simulation",
        "bench_record"
      ],
      "affects": [
        "adc-timing",
        "verification-coverage"
      ]
    },
    "effective-capacitance": {
      "severity": "engineering",
      "reason": "用准确 MPN 的 DC 偏压、温度、老化和公差核实装电容，并纳入 ESR/ESL。",
      "rules": [
        "mlcc-effective-capacitance",
        "capacitor-frequency-parasitics"
      ],
      "references": [
        "../design-and-review-circuit/references/power-and-analog-review.md",
        "references/engineering-budgets.md"
      ],
      "stages": [
        "saved_artifact",
        "simulation",
        "bench_record"
      ],
      "affects": [
        "filter-stability",
        "power-stability",
        "adc-timing"
      ]
    },
    "power-stability": {
      "severity": "engineering",
      "reason": "核启动/恢复、负载阶跃、输出稳定窗口、源负载阻抗、反馈回路和降额。按实际拓扑用适用规则。",
      "rules": [
        "ldo-output-stability",
        "pcb-pdn-impedance",
        "switching-rms-stress"
