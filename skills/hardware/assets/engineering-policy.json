    "edge-termination": {
      "knowledge_theme": "si",
      "severity": "engineering",
      "reason": "快边沿下端接、负载位置和传输线不连续会改变接收点波形；点对点源端串联是待比较的方法，按接口约束及接收点判据验收。",
      "rules": ["si-source-termination"],
      "references": ["references/si-verification.md"],
      "stages": ["saved_artifact","simulation","bench_record"],
      "affects": ["verification-coverage","measurement-integrity"],
      "intent_keywords": ["源端端接","串联端接","时钟振铃","接收端振铃","重复跨越门限","二次过门限","过冲振铃"],
      "invalidated_by": ["part","pin-pad","layout","firmware","test-fixture"],
      "phase_actions": {
        "plan": "冻结最快边沿、驱动与接收数、支线、走线长度、参考面及接收端判据。",
        "design": "按实际阻抗、驱动强弱和拓扑选端接，预留近源调试位并核成本、边沿和时序。",
        "review": "核近源端接、叠层阻抗、拓扑、支线及途中接收点；核接收端重复过门限风险。",
        "eco": "叠层、走线、I/O 驱动强度、器件和测量治具变化时重验受影响接收点。",
        "verify": "比较近端与各接收点，核高低转换、过冲、门限重复跨越和时序裕量。",
        "bringup": "在驱动端和接收端对照短接地探测，区分真实反射与测量扰动。",
        "release": "核冻结叠层、端接 BOM、布线及固件 I/O 设置与已验证工况一致。"
      }
    },
    "emc-current-path": {
      "knowledge_theme": "emc",
      "severity": "engineering",
      "reason": "屏蔽搭接、保护回流与外壳会重分配共模电流；比较不同注入点及受扰端，不能把单次屏蔽修改视为普遍修复。",
      "rules": ["emc-shield-current-path"],
      "references": ["references/emc-verification.md"],
      "stages": ["saved_artifact","simulation","bench_record"],
      "affects": ["verification-coverage","measurement-integrity"],
      "intent_keywords": ["emc","emi","eft","电磁兼容","屏蔽层","屏蔽线","共模电流","静电复位","辐射超标","传导骚扰"],
      "invalidated_by": ["part","pin-pad","layout","power","test-fixture","process"],
      "phase_actions": {
        "plan": "明确端口、线束、机壳和保护接地约束、注入点及功能判据，分配负责验证的环节。",
        "design": "绘出干扰源至外壳、屏蔽、信号地及受扰节点的闭合回路，对照可选搭接和滤波。",
        "review": "回查实体连接器、搭接、回流与布局寄生，按注入方向核有无新路径及对绝缘的影响。",
        "eco": "屏蔽、外壳、连接器或回流改变时重开受影响端口验证，核绝缘与接地边界。",
        "verify": "保持同一试验配置，在适用注入点和极性比较共模、供电及功能响应，按项目判据验收。",
        "bringup": "保留复位、供电与耦合三条假设；一次改变一个安全受控变量，返回基线复验。",
        "release": "校同版的线束、外壳、搭接工艺及端口测试证据。无目标场景覆盖则记待证。"
      }
