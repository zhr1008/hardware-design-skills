  "checks": {
    "requirements": {
      "severity": "engineering",
      "reason": "明确可测要求、对象与工况、来源范围和终点。区分保证值、假设和未知。",
      "rules": [],
      "references": [
        "../plan-electronic-product/references/system-safety-and-requirements.md"
      ],
      "stages": [
        "saved_artifact"
      ],
      "affects": []
    },
    "pre-mortem": {
      "severity": "engineering",
      "reason": "明确最可能或最严重失效、触发条件、被推翻的假设、反证和失败后的下一动作。比较可靠性、性能裕量、DFM/DFT、成本、供货和复杂度。",
      "rules": [],
      "references": [
        "../plan-electronic-product/references/system-safety-and-requirements.md"
      ],
      "stages": [
        "saved_artifact"
      ],
      "affects": []
    },
    "practical-design": {
      "severity": "engineering",
      "reason": "在安全边界内推进样机。权衡减料、常用封装/二供，保留能安全隔离的跳线或 0Ω、可测点及有具体用途的滤波/吸收位置。记录默认值和首板关闭方法。",
      "rules": [],
      "references": [
        "references/dfm-dft-verification.md",
        "../hardware-design-review/references/bring-up-troubleshooting.md"
      ],
      "stages": [
        "saved_artifact"
      ],
      "affects": [
        "test-coverage"
      ]
    },
    "rating-limits": {
      "severity": "redline",
      "reason": "按工况核保证工作区与实际绝对额定值，包含组合应力。名义典型值不能关闭已触发的额定或故障检查。",
      "rules": [
        "absolute-max-is-not-operating"
      ],
      "references": [
        "../design-and-review-circuit/references/power-and-analog-review.md",
        "references/thermal-verification.md"
      ],
      "stages": [
        "saved_artifact",
        "simulation",
        "bench_record"
      ],
      "affects": []
    },
    "power-states": {
      "severity": "redline",
      "reason": "检查上电、掉电、棕断和失联状态，外供 IO 与钳位回灌、复位默认态和实际返回路径。",
      "rules": [],
      "references": [
        "../design-and-review-circuit/references/power-and-analog-review.md",
        "../plan-electronic-product/references/system-safety-and-requirements.md"
      ],
      "stages": [
        "saved_artifact",
        "simulation",
        "bench_record"
      ],
      "affects": [
        "fault-propagation",
        "firmware-interface",
        "measurement-integrity"
      ]
    },
    "fault-propagation": {
      "severity": "redline",
      "reason": "包络开路、短路、反接及保护单点故障。追踪能量、地、下游故障与安全最终状态。",
      "rules": [
        "transistor-soa"
      ],
      "references": [
        "../design-and-review-circuit/references/power-and-analog-review.md",
        "../plan-electronic-product/references/system-safety-and-requirements.md"
      ],
      "stages": [
        "saved_artifact",
        "native_eda",
        "simulation",
        "bench_record",
        "cam_readback",
        "release_package"
      ],
      "affects": []
    },
    "wcca": {
      "severity": "engineering",
      "reason": "使用项目工况的保证 min/max，核温漂、漏电、负载与可达角点，关联校准和参考端。",
      "rules": [
        "resistor-ratio-tolerance",
        "resistor-self-heating-ratio"
      ],
      "references": [
        "references/model-checks.md",
        "../design-and-review-circuit/references/power-and-analog-review.md"
      ],
      "stages": [
        "saved_artifact",
        "simulation",
        "bench_record"
      ],
      "affects": []
    },
    "analog-drive": {
      "knowledge_theme": "analog",
      "phase_actions": {
        "plan": "分配稳定裕量、输出负载、允许过冲和建立时间，声明实际采集窗口及可测点。",
        "design": "比较直驱、输出隔离和改反馈。分别验环路稳定性与接收点建立误差，记录反馈取样点及器件模型。",
        "review": "沿输出到实际负载检查反馈取样点、串阻及采样电容。静态通过只覆盖静态范围，核动态缺项。",
        "eco": "更换放大器、反馈/滤波、ADC 采样设置或负载寄生后，重验稳定性与接收点建立。",
        "verify": "用适用的小信号方法验环路，用实际最大阶跃、负载和采集窗验时域误差，并注明模型盲区。",
        "bringup": "分别观察运放输出及接收点，改变探测加载或采样条件，区分失稳、反冲与探头伪影。",
        "release": "核冻结 BOM、原理图、板与采样配置仍在已验证范围；变化或未关闭动态缺项时保留证据缺口。"
      },
      "intent_keywords": ["运放","电压跟随器","容性负载","op amp","op-amp"],
      "invalidated_by": ["part","pin-pad","filter","layout","firmware"],
      "severity": "engineering",
      "reason": "核共模、摆幅、有限带宽和输出阻抗、容性负载、过载与稳定；不要用理想跟随器覆盖布局或实际负载。",
      "rules": [
        "analog-capacitive-load",
        "opamp-common-mode",
        "opamp-linear-output",
        "opamp-output-drive"
      ],
      "references": [
        "../design-and-review-circuit/references/power-and-analog-review.md"
      ],
      "stages": [
        "saved_artifact",
        "simulation",
        "bench_record"
      ],
      "affects": [
        "adc-timing",
        "filter-stability"
      ]
    },
    "adc-timing": {
      "severity": "engineering",
      "reason": "核实际采集窗、通道切换与串扰、回冲、基准瞬态和抗混叠分配。",
      "rules": [
        "adc-acquisition-settling",
        "adc-kickback-filter",
        "adc-antialias-budget",
        "reference-transient-load"
