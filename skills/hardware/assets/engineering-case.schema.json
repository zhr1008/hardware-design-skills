{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hardware engineering case v1",
  "type": "object",
  "required": ["schema", "mode", "baseline"],
  "properties": {
    "schema": {"const": "hardware-engineering-case-v1"},
    "mode": {"enum": ["plan", "design", "review", "eco", "verify", "bringup", "release"]},
    "intent": {"type": "string"},
    "baseline": {
      "type": "object",
      "required": ["project", "revision", "variant"],
      "properties": {
        "project": {"$ref": "#/$defs/text"},
        "revision": {"$ref": "#/$defs/text"},
        "variant": {"$ref": "#/$defs/text"}
      }
    },
    "prototypes": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "facts": {"type": "object", "additionalProperties": {"enum": ["present", "absent", "unknown"]}},
    "model_limits": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "enum": ["nominal-only", "margin-crosses-limit", "device-dynamics",
            "parasitics-dominate", "measurement-conflict", "sample-required"]
        }
      }
    },
    "artifacts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/file"}},
    "evidence": {"type": "object", "additionalProperties": {"$ref": "#/$defs/file"}},
    "checks": {"type": "object", "additionalProperties": {"$ref": "#/$defs/check"}}
  },
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/text"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "check": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["open", "pass", "fail", "not_applicable"]},
        "condition": {"$ref": "#/$defs/text"},
        "criterion": {"$ref": "#/$defs/text"},
        "finding": {"$ref": "#/$defs/text"},
        "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
      },
      "allOf": [{
        "if": {"properties": {"status": {"enum": ["pass", "fail", "not_applicable"]}}},
        "then": {"required": ["condition", "criterion", "finding", "artifacts", "evidence"]}
      }]
    }
  }
}
